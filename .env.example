# Copy to .env for local dev. Never commit real secrets.
NODE_ENV=development
PORT=18080
LOG_LEVEL=info

# Dev DB is published on localhost:15432 by ops/docker-compose.dev.yml
DATABASE_URL=postgres://erp:erp_dev_password@localhost:15432/erp

# docker compose (ops/docker-compose.yml) reads these
POSTGRES_USER=erp
POSTGRES_PASSWORD=erp_dev_password
POSTGRES_DB=erp
DB_PORT=15432

# Auth (M1). Dev-only value - generate a real one for production: openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef

