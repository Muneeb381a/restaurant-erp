# Copy to .env for local dev. Never commit real secrets.
NODE_ENV=development
PORT=18080
LOG_LEVEL=info

# Dev DB is published on localhost:15432 by ops/docker-compose.dev.yml
DATABASE_URL=postgres://erp:erp_dev_password@localhost:15432/erp

# docker compose (ops/docker-compose.yml) reads these
POSTGRES_USER=erp
POSTGRES_PASSWORD=erp_dev_password
POSTGRES_DB=erp
DB_PORT=15432

# Auth (M1). Dev-only value - generate a real one for production: openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef

# ---------- Cloud mode (many restaurants; Vercel + Neon). Leave unset for the on-site install. ----------
# Setting CONTROL_DATABASE_URL switches the API to cloud mode. See docs/DEPLOY-VERCEL-NEON.md
# CONTROL_DATABASE_URL=postgres://user:pass@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# TENANT_SECRET_KEY=            # openssl rand -base64 32   (exactly 32 bytes; losing it loses every restaurant's connection string)
# PLATFORM_JWT_SECRET=          # openssl rand -base64 48   (not the same as JWT_SECRET)
# PROVISIONER=neon              # neon | local (local = CREATE DATABASE on a Postgres you run, for development)
# NEON_API_KEY=
# NEON_REGION_ID=aws-us-east-2
# NEON_ORG_ID=                  # only if a personal API key is refused for lack of an organisation
# LOCAL_PROVISIONER_ADMIN_URL=postgres://erp:erp_dev_password@localhost:15432/postgres
# LIVE_EVENTS=off               # serverless has no shared memory: no live stream, screens poll
# TRUST_PROXY_HOPS=1            # proxies in front of the API (Vercel: 1)
# TENANT_POOL_MAX=3             # connections per restaurant per instance
# TENANT_CACHE_MAX=25           # restaurants kept warm per instance
# Web build (cloud): VITE_MULTI_TENANT=true  (scripts/vercel-build.mjs sets it)

