{
  "name": "@erp/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "tsx --env-file-if-exists=../../.env src/main.ts",
    "worker": "tsx --env-file-if-exists=../../.env src/worker.ts",
    "db:migrate": "tsx --env-file-if-exists=../../.env scripts/db-migrate.ts",
    "db:migrate:phase2": "tsx --env-file-if-exists=../../.env scripts/db-migrate.ts phase2",
    "platform:admin": "tsx --env-file-if-exists=../../.env scripts/platform-admin.ts",
    "platform:migrate": "tsx --env-file-if-exists=../../.env scripts/platform-migrate.ts",
    "db:reset": "tsx --env-file-if-exists=../../.env scripts/db-reset.ts",
    "db:codegen": "kysely-codegen --env-file=../../.env --dialect=postgres --out-file=src/db/types.ts --camel-case=false && tsx scripts/patch-types.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@erp/domain": "workspace:*",
    "@erp/fiscal-adapters": "workspace:*",
    "@erp/printing": "workspace:*",
    "@node-rs/argon2": "^2.2.2",
    "csv-parse": "^7.0.3",
    "express": "^4.21.2",
    "jose": "^6.2.16",
    "kysely": "^0.27.5",
    "node-pg-migrate": "^7.9.0",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "tsx": "^4.19.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.16.0",
    "@types/express": "^4.17.21",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "kysely-codegen": "^0.17.0",
    "supertest": "^7.0.0",
    "testcontainers": "^10.16.0",
    "vitest": "^2.1.8"
  }
}
